# Backend environment variables (NO poner secretos ni tokens aquí)
# Copia este archivo a `backend/.env` y llena valores locales.

# App
APP_ENV=local
LOG_LEVEL=INFO

# CORS (lista separada por comas)
CORS_ORIGINS=http://localhost:5173

# Lakebase (PostgreSQL wire-protocol)
LAKEBASE_HOST=
LAKEBASE_PORT=5432
LAKEBASE_DBNAME=
LAKEBASE_SSLMODE=require

# Entra token validation (definir según tu App Registration / API)
ENTRA_TENANT_ID=
ENTRA_API_AUDIENCE=
ENTRA_ISSUER=

# Databricks scope (constante por constitución)
DATABRICKS_SCOPE=2ff814a6-3304-4ab8-85cb-cd0e6f879c1d/.default
