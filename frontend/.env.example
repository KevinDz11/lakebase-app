# Frontend environment variables (NO poner secretos aquí)
# Copia este archivo a `frontend/.env` y llena valores locales.

# MSAL / Entra
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
# Ejemplo: https://login.microsoftonline.com/<tenantId>
VITE_ENTRA_AUTHORITY=
# Ejemplo: http://localhost:5173
VITE_ENTRA_REDIRECT_URI=http://localhost:5173

# API backend
# Ejemplo: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# Scopes para obtener token hacia el API (definir cuando se registre el API en Entra)
# Ejemplo: api://<backend-app-id>/access_as_user
VITE_API_SCOPES=
